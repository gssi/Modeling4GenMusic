// Validation of a teaching intent. Model T conforms to http://music/exercise;
// model L is the learner profile the intent refers to (empty when there is none).

context T!ExerciseSpec {

  critique TempoAboveComfort {
    guard: self.hasLearner()
    check: self.requestedBpm <= self.learner.comfortableBpm
      or (self.maxBpm > 0 and self.maxBpm <= self.learner.comfortableBpm)
    message: "Il tempo richiesto (" + self.requestedBpm + " bpm) supera il tempo comodo di "
      + self.learner.name + " (" + self.learner.comfortableBpm + " bpm)"
    fix {
      title: "Limita il tempo a " + self.learner.comfortableBpm + " bpm"
      do {
        self.maxBpm = self.learner.comfortableBpm;
      }
    }
  }

  // A need of the learner can bound an attribute of the spec, such as the bars or the tempo. The
  // derivation applies the bound whatever is asked here: the teacher is told before deriving.
  critique NeedLimitExceeded {
    guard: self.hasLearner()
    check: self.exceededLimits().isEmpty()
    message: self.exceededLimits().collect(l | l.get("rationale") + " (richiesto: "
      + self.requested(l.get("feature")) + ")").concat("; ")
      + ": la derivazione applicherà il limite di " + self.learner.name
  }
}

context T!ContainsPattern {

  constraint ContainsExcludesConflict {
    guard: self.pattern.isDefined()
    check: not self.eContainer().constraints.exists(c |
      c.isTypeOf(T!ExcludesPattern) and c.pattern.isDefined() and c.pattern.samePattern(self.pattern))
    message: "Il pattern '" + self.pattern.expression + "' è sia richiesto sia escluso"
  }

  critique PatternNotIntroduced {
    guard: self.pattern.isDefined() and self.pattern.kind = T!PatternKind#RHYTHM
      and self.eContainer().hasLearner()
    check: not self.eContainer().learner.patterns.exists(p |
      p.status = L!Mastery#NOT_INTRODUCED and normalize(p.expression) = normalize(self.pattern.expression))
    message: "Il pattern '" + self.pattern.expression + "' non è ancora stato introdotto a "
      + self.eContainer().learner.name
  }
}

context T!ContainsPattern {

  // A leap wider than the hand opens can be played, by moving the hand: the teacher decides.
  critique LeapBeyondReach {
    guard: self.pattern.isDefined() and self.pattern.kind = T!PatternKind#INTERVAL
      and intervals.isValid(self.pattern.expression)
      and self.eContainer().hasLearner() and self.eContainer().learner.reach().isDefined()
    check: intervals.maxLeap(self.pattern.expression) <= self.eContainer().learner.reach()
    message: "Il pattern '" + self.pattern.expression + "' contiene un salto di "
      + intervals.maxLeap(self.pattern.expression) + " semitoni ("
      + intervals.nameOf(intervals.maxLeap(self.pattern.expression)) + "), oltre l'apertura della mano destra di "
      + self.eContainer().learner.name + " (" + self.eContainer().learner.reach()
      + " semitoni, " + intervals.nameOf(self.eContainer().learner.reach())
      + "): richiede un cambio di posizione della mano e potrebbe essere troppo impegnativo"
  }
}

context T!QualityGoal {

  critique ComplexityAboveLevel {
    guard: self.level = T!Level#HIGH and self.eContainer().hasLearner() and self.skillArea().isDefined()
    check: not self.eContainer().learner.skills.exists(s |
      s.area = self.skillArea() and s.level <= MAX_LEVEL_FOR_HIGH_WARNING())
    message: "Obiettivo " + self.attribute + " HIGH, ma la skill " + self.skillArea()
      + " del learner è di livello basso (≤ " + MAX_LEVEL_FOR_HIGH_WARNING() + ")"
  }
}

operation MAX_LEVEL_FOR_HIGH_WARNING() : Integer {
  return 2;
}

// What the teacher asks for an attribute of the spec, as text; undefined when nothing is asked.
// The tempo is asked as requestedBpm and ends up bounding maxBpm.
operation T!ExerciseSpec requested(feature : String) : Any {
  if (feature = "maxBpm") { return self.requestedBpm > 0 ? self.requestedBpm.asString() : null; }
  return needs.read(self, feature);
}

// The bounds set by the learner's needs that what is asked here goes beyond.
operation T!ExerciseSpec exceededLimits() : Sequence {
  return needs.limits(self.learner).select(l |
    needs.exceeds(self.requested(l.get("feature")), l.get("value"), l.get("combine"))).asSequence();
}

operation T!ExerciseSpec hasLearner() : Boolean {
  return self.learner.isDefined() and not self.learner.eIsProxy();
}

// Skill area that backs a quality attribute, undefined when there is no correspondence.
operation T!QualityGoal skillArea() : Any {
  if (self.attribute = T!QualityAttribute#RHYTHMIC_COMPLEXITY) { return L!SkillArea#RHYTHM; }
  if (self.attribute = T!QualityAttribute#MELODIC_COMPLEXITY) { return L!SkillArea#PITCH_READING; }
  return null;
}

operation T!Pattern samePattern(other : T!Pattern) : Boolean {
  return self.kind = other.kind and normalize(self.expression) = normalize(other.expression);
}

operation normalize(expression : Any) : String {
  return rhythm.normalize(expression);
}

// How far the hand that plays the exercise reaches without moving, in semitones: the right one,
// exercises being for the right hand only. Whatever type of need sets that limit, it is read from
// the span constraints the learner's needs lead to; undefined when there is none.
operation L!Learner reach() : Any {
  var limits = needs.constraints(self, "SpanConstraint")
    .select(c | c.get("hand") = "RIGHT" and c.get("maxStretchInPosition").isDefined())
    .collect(c | c.get("maxStretchInPosition").asInteger());
  return limits.isEmpty() ? null : limits.min();
}
