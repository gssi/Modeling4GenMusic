// Validation of a learner profile. Model L conforms to http://music/profile;
// model N is the catalog of need types the profile refers to (empty when there is none).

context L!Learner {

  constraint NameRequired {
    check: self.name.isDefined() and self.name.trim().length() > 0
    message: "Il nome del learner è obbligatorio"
  }

  constraint RangeOrdered {
    check: self.lowestMidi < self.highestMidi
    message: "L'estensione non è ordinata: la nota più bassa (" + self.lowestMidi
      + ") deve essere minore della più alta (" + self.highestMidi + ")"
  }

  constraint CatalogForNeeds {
    check: self.needs.isEmpty() or self.hasCatalog()
    message: "Il profilo elenca dei bisogni ma non indica il catalogo che ne definisce i tipi"
  }
}

context L!Skill {

  constraint SkillLevelBounds {
    check: self.level >= 0 and self.level <= 5 and self.confidence >= 0 and self.confidence <= 1
    message: "La skill " + self.area + " ha valori fuori scala: livello " + self.level
      + " (ammesso 0–5), confidenza " + self.confidence + " (ammessa 0–1)"
  }
}

// A need says nothing by itself: its type, in the catalog, tells which values it takes.
context L!Need {

  constraint NeedTypeFromCatalog {
    guard: self.eContainer().hasCatalog()
    check: self.isTyped()
    message: "Il bisogno non è di un tipo del catalogo «" + self.eContainer().catalog.name + "»"
  }

  constraint RequiredParameters {
    guard: self.eContainer().hasCatalog() and self.isTyped()
    check: self.missing().isEmpty()
    message: self.type.caption() + ": manca " + self.missing().collect(p | p.caption()).concat(", ")
  }
}

context L!Slot {

  constraint SlotOfTheType {
    guard: self.eContainer().eContainer().hasCatalog() and self.eContainer().isTyped()
    check: self.isOfTheType()
    message: self.eContainer().type.caption() + ": un valore non corrisponde a nessun parametro del tipo"
  }

  constraint SlotValue {
    guard: self.eContainer().eContainer().hasCatalog() and self.eContainer().isTyped() and self.isOfTheType()
      and self.value.isDefined() and self.value.trim().length() > 0
    check: needs.problemOf(self.parameter, self.value).isUndefined()
    message: self.eContainer().type.caption() + ", " + self.parameter.caption().firstToLowerCase() + ": "
      + needs.problemOf(self.parameter, self.value)
  }
}

context L!PatternMastery {

  constraint PatternSyntax {
    check: rhythm.isValid(self.expression)
    message: "Pattern ritmico non valido: " + rhythm.errorOf(self.expression)
  }
}

operation L!Learner hasCatalog() : Boolean {
  return self.catalog.isDefined() and not self.catalog.eIsProxy();
}

operation L!Need isTyped() : Boolean {
  return self.type.isDefined() and not self.type.eIsProxy() and self.type.eContainer() = self.eContainer().catalog;
}

operation L!Slot isOfTheType() : Boolean {
  return self.parameter.isDefined() and self.eContainer().type.parameters.includes(self.parameter);
}

// Required parameters that have neither a value in the profile nor a default in the catalog.
operation L!Need missing() : Sequence {
  return self.type.parameters.select(p | p.required and needs.parameterValue(self, p).isUndefined()).asSequence();
}

operation Any caption() : String {
  return self.label.isDefined() and self.label.trim().length() > 0 ? self.label : self.name;
}
