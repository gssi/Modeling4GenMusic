// Derivation of a complete exercise spec from the learner profile (L), the teaching intent (T)
// and the quality model (Q). The needs of the learner are typed by a catalog (N, empty when the
// profile has none): what each of them does to the spec is read from its type, not written here. It writes the spec (S) and a weaving model (W): every element or
// attribute created in S gets a Link in W with the rule that produced it and a readable rationale.
//
// Rules that create elements are transformation rules; rules that only set attributes of the spec,
// or only add links, are named `post` blocks. They run in the order of this file.

// ---------------------------------------------------------------- thresholds

// Occurrences required for a pattern the learner is still learning.
operation LEARNING_MIN_OCCURRENCES() : Integer { return 3; }

// Occurrences required for a pattern already mastered, or unknown to the profile.
operation DEFAULT_MIN_OCCURRENCES() : Integer { return 1; }

// Quality attributes that get a LOW goal when the teacher does not mention them.
operation FOCUS_DIMENSIONS() : Sequence {
  return Sequence{T!QualityAttribute#RHYTHMIC_COMPLEXITY, T!QualityAttribute#MELODIC_COMPLEXITY};
}

// ---------------------------------------------------------------- setup

pre {
  if (L!Learner.all.isEmpty()) { throw "il profilo non contiene un learner"; }
  if (T!ExerciseSpec.all.isEmpty()) { throw "l'intento non contiene una specifica di esercizio"; }

  var weaving = new W!DerivationWeaving;
  ids.exact(weaving, "weaving");
  weaving.name = learner().name;
  weaving.learner = learner();
  weaving.teacherIntent = intent();
  weaving.qualityModel = Q!QualityModel.all.first();
  weaving.needCatalog = N!NeedCatalog.all.first();
}

// ---------------------------------------------------------------- rules that create elements

// 1. The spec starts as a copy of what the teacher asked for.
rule CopyIntent
  transform t : T!ExerciseSpec
  to s : S!ExerciseSpec {

  guard: t = intent()

  ids.exact(s, "spec");
  weaving().derivedSpec = s;

  s.key = t.key;
  refinement("CopyIntent", s, "key", "Tonalità scelta dalla docente").from(W!Origin#TEACHER, t, "key");
  s.meter = t.meter;
  refinement("CopyIntent", s, "meter", "Metro scelto dalla docente").from(W!Origin#TEACHER, t, "meter");
  s.bars = t.bars;
  refinement("CopyIntent", s, "bars", "Numero di battute scelto dalla docente").from(W!Origin#TEACHER, t, "bars");
  if (t.requestedBpm > 0) {
    s.requestedBpm = t.requestedBpm;
    refinement("CopyIntent", s, "requestedBpm", "Tempo richiesto dalla docente")
      .from(W!Origin#TEACHER, t, "requestedBpm");
  }
}

// 4. A requested pattern is weighted by how well the learner knows it.
rule StrengthenLearningPattern
  transform c : T!ContainsPattern
  to d : S!ContainsPattern, p : S!Pattern {

  guard: c.eContainer() = intent() and c.pattern.isDefined()

  ids.numbered(d, "c_contains");
  ids.exact(p, ids.of(d) + "_pattern");
  p.kind = c.pattern.kind;
  p.expression = c.pattern.expression;
  d.pattern = p;
  d.weight = c.weight;

  var mastery = c.pattern.masteryInProfile();
  var rationale;
  if (mastery.isDefined() and mastery.status = L!Mastery#LEARNING) {
    d.strength = S!Strength#HARD;
    d.minOccurrences = LEARNING_MIN_OCCURRENCES();
    rationale = "Il pattern '" + p.expression + "' è in fase di apprendimento: diventa obbligatorio, con almeno "
      + LEARNING_MIN_OCCURRENCES() + " occorrenze";
  } else if (mastery.isDefined() and mastery.status = L!Mastery#MASTERED) {
    d.strength = S!Strength#SOFT;
    d.minOccurrences = DEFAULT_MIN_OCCURRENCES();
    rationale = "Il pattern '" + p.expression + "' è già padroneggiato: resta una preferenza";
  } else {
    d.strength = S!Strength#HARD;
    d.minOccurrences = DEFAULT_MIN_OCCURRENCES();
    rationale = "Il pattern '" + p.expression + "' non risulta padroneggiato nel profilo: resta obbligatorio come richiesto";
  }

  var link = refinement("StrengthenLearningPattern", d, null, rationale).from(W!Origin#TEACHER, c, null);
  if (mastery.isDefined()) { link.from(W!Origin#PROFILE, mastery, "status"); }
  refinement("StrengthenLearningPattern", p, null, "Pattern richiesto dalla docente")
    .from(W!Origin#TEACHER, c.pattern, null);

  spec().constraints.add(d);
}

// Constraints of other kinds written by the teacher are kept as they are.
// (Not in the original rule table: without these rules they would be lost.)
rule CopyTeacherExclusion
  transform c : T!ExcludesPattern
  to d : S!ExcludesPattern, p : S!Pattern {

  guard: c.eContainer() = intent() and c.pattern.isDefined()

  ids.numbered(d, "c_excludes");
  ids.exact(p, ids.of(d) + "_pattern");
  p.kind = c.pattern.kind;
  p.expression = c.pattern.expression;
  d.pattern = p;
  d.copyBasics(c);
  refinement("CopyTeacherConstraints", d, null, "Esclusione scritta dalla docente").from(W!Origin#TEACHER, c, null);
  refinement("CopyTeacherConstraints", p, null, "Pattern escluso dalla docente").from(W!Origin#TEACHER, c.pattern, null);
  spec().constraints.add(d);
}

rule CopyTeacherRange
  transform c : T!RangeConstraint
  to d : S!RangeConstraint {

  guard: c.eContainer() = intent()

  ids.numbered(d, "c_range");
  d.lowestMidi = c.lowestMidi;
  d.highestMidi = c.highestMidi;
  d.copyBasics(c);
  refinement("CopyTeacherConstraints", d, null, "Estensione scritta dalla docente").from(W!Origin#TEACHER, c, null);
  spec().constraints.add(d);
}

rule CopyTeacherRender
  transform c : T!RenderConstraint
  to d : S!RenderConstraint {

  guard: c.eContainer() = intent()

  ids.numbered(d, "c_render");
  d.staffScale = c.staffScale;
  d.copyBasics(c);
  refinement("CopyTeacherConstraints", d, null, "Resa grafica scritta dalla docente").from(W!Origin#TEACHER, c, null);
  spec().constraints.add(d);
}

// 5. Patterns the learner has not met yet are kept out, unless the teacher asks for them explicitly.
rule ExcludeNotIntroduced
  transform m : L!PatternMastery
  to d : S!ExcludesPattern, p : S!Pattern {

  guard: m.eContainer() = learner() and m.status = L!Mastery#NOT_INTRODUCED and not m.isRequestedByTeacher()

  ids.numbered(d, "c_excludes");
  ids.exact(p, ids.of(d) + "_pattern");
  p.kind = S!PatternKind#RHYTHM;
  p.expression = m.expression;
  d.pattern = p;
  d.strength = S!Strength#HARD;

  derivation("ExcludeNotIntroduced", d, null,
    "Il pattern '" + m.expression + "' non è ancora stato introdotto a " + learner().name + ": viene escluso")
    .from(W!Origin#PROFILE, m, "status");
  derivation("ExcludeNotIntroduced", p, null, "Pattern preso dal profilo")
    .from(W!Origin#PROFILE, m, "expression");
  spec().constraints.add(d);
}

// 6. Notes stay within what the learner can play.
rule RangeFromLearner
  transform l : L!Learner
  to d : S!RangeConstraint {

  guard: l = learner()

  ids.numbered(d, "c_range");
  d.strength = S!Strength#HARD;
  d.lowestMidi = l.lowestMidi;
  d.highestMidi = l.highestMidi;

  derivation("RangeFromLearner", d, null,
    "Estensione di " + l.name + ": dalla nota MIDI " + l.lowestMidi + " alla " + l.highestMidi)
    .from(W!Origin#PROFILE, l, "lowestMidi")
    .from(W!Origin#PROFILE, l, "highestMidi");
  spec().constraints.add(d);
}

// 8. Quality goals set by the teacher are kept.
rule CopyQualityGoals
  transform g : T!QualityGoal
  to q : S!QualityGoal {

  guard: g.eContainer() = intent()

  ids.exact(q, g.attribute.goalId());
  q.attribute = g.attribute;
  q.level = g.level;

  refinement("CopyQualityGoals", q, null, "Obiettivo " + g.attribute + " " + g.level + " fissato dalla docente")
    .from(W!Origin#TEACHER, g, null);
  spec().qualityGoals.add(q);
}

// ---------------------------------------------------------------- rules that complete the spec

// 2. Instrument and learner come from the profile.
post InstrumentFromLearner {
  var s = spec();
  var l = learner();
  s.instrument = l.instrument;
  derivation("InstrumentFromLearner", s, "instrument", "Strumento di " + l.name + ": " + l.instrument)
    .from(W!Origin#PROFILE, l, "instrument");
  s.learner = l;
  derivation("InstrumentFromLearner", s, "learner", "L'esercizio è per " + l.name)
    .from(W!Origin#PROFILE, l, null);
}

// 3. The tempo never exceeds the one the learner is comfortable with.
post TempoLimit {
  var s = spec();
  var t = intent();
  var l = learner();
  var requested = t.requestedBpm;
  var comfortable = l.comfortableBpm;

  if (requested > 0 and (comfortable <= 0 or requested <= comfortable)) {
    s.maxBpm = requested;
    refinement("TempoLimit", s, "maxBpm", "Il tempo richiesto (" + requested + " bpm) è entro il tempo comodo")
      .from(W!Origin#TEACHER, t, "requestedBpm");
  } else if (requested > 0) {
    s.maxBpm = comfortable;
    var fix = new W!ConflictFix;
    fix.critique = "TempoAboveComfort";
    fix.originalValue = requested.asString();
    fix.newValue = comfortable.asString();
    fix.init("TempoLimit", s, "maxBpm",
      "Il tempo richiesto (" + requested + " bpm) supera il tempo comodo di " + l.name + ": limitato a "
      + comfortable + " bpm")
      .from(W!Origin#TEACHER, t, "requestedBpm")
      .from(W!Origin#PROFILE, l, "comfortableBpm");
  } else if (comfortable > 0) {
    s.maxBpm = comfortable;
    derivation("TempoLimit", s, "maxBpm", "Nessun tempo richiesto: si usa il tempo comodo di " + l.name)
      .from(W!Origin#PROFILE, l, "comfortableBpm");
  }
}

// 7. Each need of the learner adds the constraints its type describes. Nothing here names a kind of
// need or of constraint: the class to create and the features to set come from the catalog, so a
// type added there is applied without touching this script. A limit is stable: always hard.
post ApplyNeeds {
  for (need in typedNeeds()) {
    for (effect in need.type.effects.select(e | e.isTypeOf(N!ConstraintEffect))) {
      var d = S.createInstance(effect.constraintClass);
      ids.numbered(d, effect.constraintClass.idBase());
      d.strength = S!Strength#HARD;
      var link = derivation("ApplyNeeds", d, null, need.explain(effect));
      for (binding in effect.bindings) {
        var value = needs.valueOf(need, binding);
        if (value.isDefined()) {
          for (child in needs.set(d, binding.feature, value)) {
            ids.exact(child, ids.of(d) + "_" + child.eContainingFeature().name);
            derivation("ApplyNeeds", child, null, need.explain(effect)).from(W!Origin#NEED_CATALOG, effect, null);
          }
          link.fromNeed(need, binding);
        }
      }
      link.from(W!Origin#NEED_CATALOG, effect, null);
      spec().constraints.add(d);
    }
  }
}

// A need can also bound an attribute of the spec itself, such as the tempo or the number of bars.
// It runs after the rules above, so that it has the last word on what they decided.
// When the bound overrides what the teacher asked, the link is the fix of the NeedLimitExceeded
// warning of the intent; when it only tightens a value taken from the profile, it is a derivation.
post ApplyNeedLimits {
  var s = spec();
  for (need in typedNeeds()) {
    for (effect in need.type.effects.select(e | e.isTypeOf(N!SpecEffect))) {
      var value = needs.valueOf(need, effect);
      if (value.isDefined()) {
        var before = needs.read(s, effect.feature);
        if (needs.limit(s, effect.feature, value, effect.combine.name)) {
          var link;
          if (before.isDefined() and needs.exceeds(intent().requested(effect.feature), value, effect.combine.name)) {
            link = new W!ConflictFix;
            link.critique = "NeedLimitExceeded";
            link.originalValue = before;
            link.newValue = needs.read(s, effect.feature);
            link.init("ApplyNeedLimits", s, effect.feature, need.explain(effect));
          } else {
            link = derivation("ApplyNeedLimits", s, effect.feature, need.explain(effect));
          }
          link.fromNeed(need, effect).from(W!Origin#NEED_CATALOG, effect, null);
        }
      }
    }
  }
}

// 9. Dimensions the teacher does not mention stay simple, to keep the focus on the others.
post FocusOtherDimensionsLow {
  var s = spec();
  for (attribute in FOCUS_DIMENSIONS()) {
    if (not s.qualityGoals.exists(g | g.attribute = attribute)) {
      var q = new S!QualityGoal;
      ids.exact(q, attribute.goalId());
      q.attribute = attribute;
      q.level = S!Level#LOW;
      s.qualityGoals.add(q);
      derivation("FocusOtherDimensionsLow", q, null,
        "La docente non indica un obiettivo per " + attribute + ": resta basso per non distrarre dal resto")
        .from(W!Origin#RULE_DEFAULT, intent(), null);
    }
  }
}

// 10. Each quality goal is resolved to the band of the quality model that defines its thresholds.
post ResolveThresholds {
  for (goal in spec().qualityGoals) {
    var band = Q!Band.all.selectOne(b | b.level = goal.level and b.eContainer().attribute = goal.attribute);
    if (band.isDefined()) {
      var link = new W!Resolution;
      link.init("ResolveThresholds", goal, null,
        goal.attribute + " " + goal.level + " significa " + band.eContainer().metric + " tra " + band.min
        + " e " + band.max)
        .from(W!Origin#QUALITY_MODEL, band, null);
    }
  }
}

// ---------------------------------------------------------------- helpers

operation learner() : L!Learner { return L!Learner.all.first(); }

operation intent() : T!ExerciseSpec { return T!ExerciseSpec.all.first(); }

operation spec() : S!ExerciseSpec { return intent().equivalent(); }

operation weaving() : W!DerivationWeaving { return W!DerivationWeaving.all.first(); }

// What the teacher asks for an attribute of the spec, as in intent.evl: the tempo is asked as
// requestedBpm and ends up bounding maxBpm.
operation T!ExerciseSpec requested(feature : String) : Any {
  if (feature = "maxBpm") { return self.requestedBpm > 0 ? self.requestedBpm.asString() : null; }
  return needs.read(self, feature);
}

// The needs whose type is found in the catalog, in the order of the profile.
operation typedNeeds() : Sequence {
  return learner().needs.select(n | n.type.isDefined() and not n.type.eIsProxy()).asSequence();
}

// "RangeConstraint" gives ids like c_range_1, "ExcludesPattern" like c_excludes_1.
operation String idBase() : String {
  return "c_" + self.replace("Constraint", "").replace("Pattern", "").toLowerCase();
}

// The rationale of an effect with the values of this learner in place of the parameter names.
operation L!Need explain(effect : Any) : String {
  var text = effect.rationale.isDefined() ? effect.rationale : self.type.name;
  for (parameter in self.type.parameters) {
    text = needs.fill(text, parameter.name, parameter.show(needs.parameterValue(self, parameter)));
  }
  return text;
}

operation N!ParameterDef show(value : Any) : Any {
  if (value.isUndefined()) { return null; }
  if (self.kind = N!ParameterKind#HAND) { return value = "LEFT" ? "sinistra" : "destra"; }
  if (self.kind = N!ParameterKind#INTERVAL) {
    return value + " semitoni (" + intervals.nameOf(value.asInteger()) + ")";
  }
  return value;
}

// Source of a value that comes from a parameter: the slot of the profile, or the type when the
// default of the catalog was used. A literal has no source in the profile.
operation W!Link fromNeed(need : Any, value : Any) : W!Link {
  if (value.parameter.isUndefined()) { return self; }
  var slot = needs.slotOf(need, value.parameter);
  if (slot.isDefined()) { return self.from(W!Origin#PROFILE, slot, "value"); }
  return self.from(W!Origin#NEED_CATALOG, value.parameter, "defaultValue");
}

// Entry of the profile for a rhythm pattern, compared regardless of spacing.
operation T!Pattern masteryInProfile() : Any {
  if (self.kind <> T!PatternKind#RHYTHM) { return null; }
  return learner().patterns.selectOne(m | rhythm.normalize(m.expression) = rhythm.normalize(self.expression));
}

operation L!PatternMastery isRequestedByTeacher() : Boolean {
  return intent().constraints.exists(c | c.isTypeOf(T!ContainsPattern) and c.pattern.isDefined()
    and c.pattern.kind = T!PatternKind#RHYTHM
    and rhythm.normalize(c.pattern.expression) = rhythm.normalize(self.expression));
}

operation S!Constraint copyBasics(source : T!Constraint) {
  self.strength = source.strength;
  self.weight = source.weight;
}

operation Any goalId() : String {
  return "qg_" + self.name.toLowerCase();
}

operation refinement(ruleName : String, target : Any, feature : Any, rationale : String) : W!Link {
  var link = new W!Refinement;
  return link.init(ruleName, target, feature, rationale);
}

operation derivation(ruleName : String, target : Any, feature : Any, rationale : String) : W!Link {
  var link = new W!Derivation;
  return link.init(ruleName, target, feature, rationale);
}

// Fills the common part of a link and adds it to the weaving.
operation W!Link init(ruleName : String, target : Any, feature : Any, rationale : String) : W!Link {
  ids.numbered(self, "link");
  self.`rule` = ruleName; // `rule` is an ETL keyword, hence the quotes
  self.target = target;
  self.targetFeature = feature;
  self.rationale = rationale;
  weaving().links.add(self);
  return self;
}

// Adds a source end: where the value comes from and, when it is a single attribute, which one.
operation W!Link from(origin : Any, element : Any, feature : Any) : W!Link {
  var source = new W!SourceEnd;
  ids.exact(source, ids.of(self) + "_source_" + (self.sources.size() + 1));
  source.origin = origin;
  source.element = element;
  source.feature = feature;
  self.sources.add(source);
  return self;
}
