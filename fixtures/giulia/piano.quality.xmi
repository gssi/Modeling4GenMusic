<?xml version="1.0" encoding="UTF-8"?>
<qm:QualityModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:qm="http://music/quality" xmi:id="piano_quality">
  <bindings xmi:id="b_rhythm" metric="rhythmScore">
    <bands xmi:id="r_low" max="0.3"/>
    <bands xmi:id="r_med" level="MEDIUM" min="0.3" max="0.6"/>
    <bands xmi:id="r_high" level="HIGH" min="0.6" max="1.0"/>
  </bindings>
  <bindings xmi:id="b_melodic" attribute="MELODIC_COMPLEXITY" metric="melodicScore">
    <bands xmi:id="m_low" max="0.35"/>
    <bands xmi:id="m_med" level="MEDIUM" min="0.35" max="0.65"/>
    <bands xmi:id="m_high" level="HIGH" min="0.65" max="1.0"/>
  </bindings>
</qm:QualityModel>
