@namespace(uri="http://music/profile", prefix="pr")
package profile;

import "needs.ecore";

class Learner {
  attr String[1] name;
  attr Instrument instrument;
  attr int comfortableBpm;
  attr int lowestMidi;
  attr int highestMidi;
  val Skill[*] skills;
  ref needs.NeedCatalog catalog;       // where the types of the needs below are defined
  val Need[*] needs;
  val PatternMastery[*] patterns;
}

class Skill {
  attr SkillArea area;
  attr int level;
  attr double confidence;
}

// A need of this learner: which type of the catalog it is and the value of each of its parameters.
// What a need does to an exercise is written in its type, not here.
class Need {
  ref needs.NeedType[1] type;
  val Slot[*] slots;
}

class Slot {
  ref needs.ParameterDef[1] parameter;
  attr String value;
}

class PatternMastery {
  attr String expression;
  attr Mastery status;
}

enum Instrument {
  PIANO = 0;
  GUITAR = 1;
  FLUTE = 2;
}

enum Hand {
  LEFT = 0;
  RIGHT = 1;
}

enum SkillArea {
  RHYTHM = 0;
  PITCH_READING = 1;
  TECHNIQUE = 2;
}

enum Mastery {
  MASTERED = 0;
  LEARNING = 1;
  NOT_INTRODUCED = 2;
}
