@namespace(uri="http://music/exercise", prefix="ex")
package exercise;

import "profile.ecore";
import "quality.ecore";

class ExerciseSpec {
  ref profile.Learner learner;
  ref quality.QualityModel qualityModel;   // where the dimensions of the quality goals are defined
  attr profile.Instrument instrument;
  attr String key;
  attr String meter;
  attr int bars;
  attr int maxBpm;
  attr int requestedBpm;
  val Constraint[*] constraints;
  val QualityGoal[*] qualityGoals;
}

abstract class Constraint {
  attr Strength strength;
  attr double weight = "1.0";
}

class ContainsPattern extends Constraint {
  val Pattern[1] pattern;
  attr int minOccurrences = "1";
}

class ExcludesPattern extends Constraint {
  val Pattern[1] pattern;
}

class RangeConstraint extends Constraint {
  attr int lowestMidi;
  attr int highestMidi;
}

class RenderConstraint extends Constraint {
  attr double staffScale;
}

// What one hand can reach, from a physical limit of the learner.
class SpanConstraint extends Constraint {
  attr profile.Hand[1] hand;
  attr int maxSimultaneousSemitones;   // widest interval between notes played together by that hand
  attr int maxStretchInPosition;       // widest melodic leap without moving the hand
}

class Pattern {
  attr PatternKind kind;
  attr String expression;
}

// How demanding the exercise should be along one dimension of the quality model.
class QualityGoal {
  ref quality.QualityDimension[1] dimension;
  attr quality.Level level;
}

enum Strength {
  HARD = 0;
  SOFT = 1;
}

enum PatternKind {
  RHYTHM = 0;
  INTERVAL = 1;
  HARMONY = 2;
}
