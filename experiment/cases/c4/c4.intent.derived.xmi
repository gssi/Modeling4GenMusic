<?xml version="1.0" encoding="UTF-8"?>
<ex:ExerciseSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ex="http://music/exercise" xmi:id="spec" key="F" meter="3/4" bars="8" maxBpm="76" requestedBpm="76">
  <learner href="c4.profile.xmi#sara"/>
  <constraints xsi:type="ex:ContainsPattern" xmi:id="c_contains_1" strength="SOFT">
    <pattern xmi:id="c_contains_1_pattern" expression="8 8"/>
  </constraints>
  <constraints xsi:type="ex:RangeConstraint" xmi:id="c_range_1" lowestMidi="60" highestMidi="77"/>
  <constraints xsi:type="ex:RenderConstraint" xmi:id="c_render_1" staffScale="1.8"/>
  <constraints xsi:type="ex:ExcludesPattern" xmi:id="c_excludes_1">
    <pattern xmi:id="c_excludes_1_pattern" expression="16 16"/>
  </constraints>
  <qualityGoals xmi:id="qg_rhythmic_complexity" level="MEDIUM"/>
  <qualityGoals xmi:id="qg_melodic_complexity" attribute="MELODIC_COMPLEXITY"/>
</ex:ExerciseSpec>
