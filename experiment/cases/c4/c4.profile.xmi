<?xml version="1.0" encoding="UTF-8"?>
<pr:Learner xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:pr="http://music/profile" xmi:id="sara" name="sara" comfortableBpm="80" lowestMidi="60" highestMidi="77">
  <skills xmi:id="skill_rhythm" level="3" confidence="0.7"/>
